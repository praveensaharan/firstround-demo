# FirstRound — environment
# cp .env.example .env and fill in your own values.

# ── Perxona Connect (required) ─────────────────────────────────────────────
# Region must match PRESENTER_URL below or the avatar silently never loads.
PERXONA_API_BASE_URL=https://console.perxona.ai/asia
PERXONA_CONNECT_SECRET_KEY=
PERXONA_CONNECT_PUBLISHABLE_KEY=
PRESENTER_URL=https://cdn.perxona.ai/asia/prod/latest/widget/entry/presenter.js

# ── Default interviewer stage ──────────────────────────────────────────────
# Organizations override these per-role in the console; these are the fallback.
DEFAULT_AVATAR_ID=
DEFAULT_SCENE_ID=
DEFAULT_VOICE_ID=

# ── LLM (required) ─────────────────────────────────────────────────────────
# LLM_MODEL runs live branch routing, which blocks the avatar's next line —
# keep it fast.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-flash

# Optional. Used only for map generation and post-interview scoring, both off
# the interview's critical path, where quality matters and latency does not.
# Leave blank and those calls use LLM_MODEL too.
LLM_MODEL_QUALITY=deepseek-v4-pro

PORT=8084
